{
  "id": "15_stack_coupling",
  "title": "Deploy stack knobs: corrector coupling x dynamic occlusion (legacy biochem)",
  "model": "locked_canonical",
  "axis": "stack_coupling",
  "description": "Legacy mat-growth stack only. Ablate BIOCHEM_CORRECTOR_COUPLING and SPECIES_DYNAMIC_OCCLUSION (same locked weights). Run with: python scripts/run_research_sweep.py --sweep legacy/15_stack_coupling --legacy",
  "control": {"include_velocity": true},
  "arms": [
    {
      "name": "corr1_dyn1",
      "axis_value": 3,
      "env_overrides": {
        "BIOCHEM_CORRECTOR_COUPLING": "1",
        "SPECIES_DYNAMIC_OCCLUSION": "1",
        "BIOCHEM_ROLLOUT_DYNAMIC_OCCLUSION": "1"
      },
      "labels": {"corrector": 1, "dynamic_occlusion": 1}
    },
    {
      "name": "corr0_dyn1",
      "axis_value": 1,
      "env_overrides": {
        "BIOCHEM_CORRECTOR_COUPLING": "0",
        "SPECIES_DYNAMIC_OCCLUSION": "1",
        "BIOCHEM_ROLLOUT_DYNAMIC_OCCLUSION": "1"
      },
      "labels": {"corrector": 0, "dynamic_occlusion": 1}
    },
    {
      "name": "corr1_dyn0",
      "axis_value": 2,
      "env_overrides": {
        "BIOCHEM_CORRECTOR_COUPLING": "1",
        "SPECIES_DYNAMIC_OCCLUSION": "0",
        "BIOCHEM_ROLLOUT_DYNAMIC_OCCLUSION": "0"
      },
      "labels": {"corrector": 1, "dynamic_occlusion": 0}
    },
    {
      "name": "corr0_dyn0",
      "axis_value": 0,
      "env_overrides": {
        "BIOCHEM_CORRECTOR_COUPLING": "0",
        "SPECIES_DYNAMIC_OCCLUSION": "0",
        "BIOCHEM_ROLLOUT_DYNAMIC_OCCLUSION": "0"
      },
      "labels": {"corrector": 0, "dynamic_occlusion": 0}
    }
  ]
}
